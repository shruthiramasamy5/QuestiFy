# Copy to .env (or export these) before running institution-service.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=institution_service
DB_USERNAME=change_me
DB_PASSWORD=change_me
SERVER_PORT=8082
EUREKA_SERVER_URL=http://localhost:8761/eureka/
# Must match auth-service questify.jwt.secret exactly
QUESTIFY_JWT_SECRET=change_me_same_as_auth_service
