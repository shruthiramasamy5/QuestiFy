# ==============================================================================
# QuestiFy Docker Environment Configuration Template
# ==============================================================================

# Database credentials
DB_USERNAME=root
DB_PASSWORD=Shruthika@Y150
MYSQL_ROOT_PASSWORD=Shruthika@Y150

# Database host port mappings (to avoid collision with host MySQL/MongoDB)
MYSQL_HOST_PORT=3307
MONGO_HOST_PORT=27018

# Shared JWT secret key (must be at least 256 bits for HS256)
QUESTIFY_JWT_SECRET=questify-dev-secret-key-change-me-before-deploying-anywhere-real

# AI Service (Google Gemini API)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Host Port Mappings
FRONTEND_PORT=5173
GATEWAY_PORT=8000
EUREKA_PORT=8761

# Microservices direct host ports (optional debugging)
AUTH_SERVICE_PORT=8081
INSTITUTION_SERVICE_PORT=8082
QUESTION_BANK_SERVICE_PORT=8083
AI_SERVICE_PORT=8084
PAPER_GENERATION_SERVICE_PORT=8085
PAPERS_SERVICE_PORT=8086
APPROVAL_SERVICE_PORT=8087
ANALYTICS_SERVICE_PORT=8088
BACKUP_SERVICE_PORT=8089
AUDIT_LOG_SERVICE_PORT=8090
ML_HEALTH_SERVICE_PORT=8091
